{
 "version": 2,
 "builds": [
  {
   "src": "src/server.js",
   "use": "@vercel/node",
   "config": { "includeFiles": ["dist/**"] }
  }
 ],
"routes": [
  { "src": "/api/(.*)", "dest": "/src/server.js" },
  { "src": "/login(.*)", "dest": "/src/server.js" },
  { "src": "/signup(.*)", "dest": "/src/server.js" },
  { "src": "/verify(.*)", "dest": "/src/server.js" },
  { "src": "/(.*)", "dest": "src/server.js" },
  { "src": "/", "dest": "src/server.js" }
]
}